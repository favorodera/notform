{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "sync-repl-workers"
      ],
      "outputs": [
        "dist/**",
        ".nuxt/**",
        ".output/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "sync-repl-workers": {
      "outputs": ["public/repl-workers/**"]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "sync-repl-workers"],
      "persistent": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    },
    "test:watch": {
      "persistent": true,
      "cache": false
    },
    "postinstall": {
      "dependsOn": ["sync-repl-workers"],
      "outputs": []
    },
    "prepublishOnly": {
      "outputs": []
    }
  }
}