{
  "name": "notform-monorepo",
  "version": "3.0.1",
  "private": true,
  "packageManager": "pnpm@11.28.3",
  "description": "Vue Forms Without the Friction",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "homepage": "https://notformdocs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/notform.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/notform/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "pnpm lint:root && turbo lint",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "lint:fix": "pnpm lint:root:fix && turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "postinstall": "turbo postinstall",
    "sync-repl-workers": "turbo sync-repl-workers",
    "preview": "turbo preview",
    "prepublishOnly": "turbo prepublishOnly",
    "ready": "pnpm install && pnpm lint:fix && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pkg-pr-new": "catalog:",
    "relizy": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
