{
  "name": "notform",
  "version": "4.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "Vue Forms Without the Friction",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "homepage": "https://notformdocs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/notform.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/notform/issues"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0 <25.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "turbo dev play",
    "play": "turbo play",
    "build": "turbo build",
    "lint": "pnpm lint:root && turbo lint",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "lint:fix": "pnpm lint:root:fix && turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "docs:copy-repl-workers": "turbo run docs:copy-repl-workers",
    "preview": "turbo preview",
    "prepublishOnly": "turbo prepublishOnly",
    "ready": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@ai-sdk/google": "catalog:",
    "@favorodera/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "eslint": "catalog:",
    "pkg-pr-new": "catalog:",
    "relizy": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
