{
  "name": "nuxt-playground",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "nuxt prepare && eslint . --fix"
  },
  "dependencies": {
    "notform-nuxt": "workspace:*",
    "nuxt": "catalog:vendor",
    "vue": "catalog:vendor",
    "vue-router": "catalog:vendor",
    "zod": "catalog:vendor"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:tools",
    "@nuxt/eslint": "catalog:tools",
    "vue-tsc": "catalog:tools"
  }
}
