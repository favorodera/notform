{
  "name": "notform",
  "type": "module",
  "version": "2.2.1",
  "private": false,
  "description": "Vue Forms Without the Friction",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://notformdocs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/notform.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/notform/issues"
  },
  "keywords": [
    "notform",
    "vue",
    "form",
    "vue form",
    "validator",
    "vue form validator"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:watch": "vitest watch --ui",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "catalog:peer"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:vendor",
    "dequal": "catalog:vendor",
    "dot-prop": "catalog:vendor",
    "klona": "catalog:vendor"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:tools",
    "@types/node": "catalog:tools",
    "@vitejs/plugin-vue": "catalog:tools",
    "@vitest/ui": "catalog:tools",
    "@vue/test-utils": "catalog:tools",
    "happy-dom": "catalog:tools",
    "tsdown": "catalog:tools",
    "type-fest": "catalog:tools",
    "vite": "catalog:tools",
    "vitest": "catalog:tools",
    "vue": "catalog:peer",
    "vue-tsc": "catalog:tools"
  }
}
