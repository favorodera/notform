{
  "name": "@notform/nuxt",
  "type": "module",
  "version": "4.0.0-alpha.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Official Nuxt integration for NotForm.",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://notformdocs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/notform.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/notform/issues"
  },
  "keywords": [
    "notform",
    "vue",
    "nuxt",
    "form",
    "standard-schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": ["./dist/types.d.mts"]
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxt-module-build prepare && nuxt-module-build build --stub",
    "lint": "nuxt-module-build prepare && eslint .",
    "lint:fix": "nuxt-module-build prepare && eslint . --fix",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "notform": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "nuxt": "catalog:",
    "vue-tsc": "catalog:"
  }
}
