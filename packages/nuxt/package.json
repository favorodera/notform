{
  "name": "notform-nuxt",
  "type": "module",
  "version": "2.2.5",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Official notform nuxt module - Vue Forms Without the Friction",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://notformdocs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/notform.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/notform/issues"
  },
  "keywords": [
    "notform-nuxt",
    "nuxt",
    "form",
    "nuxt form",
    "validator",
    "nuxt form validator"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": ["./dist/types.d.mts"]
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepack": "pnpm build",
    "dev": "nuxt prepare && nuxt-module-build build --stub",
    "build": "nuxt prepare && nuxt-module-build build",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "nuxt prepare && eslint . --fix"
  },
  "peerDependencies": {
    "notform": "workspace:*",
    "nuxt": "^4.5.0"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "notform": "workspace:*"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "nuxt": "catalog:",
    "vue-tsc": "catalog:"
  }
}
