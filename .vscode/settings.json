{
  "editor.tabSize": 2,
  "eslint.format.enable": true,
  "editor.detectIndentation": false,
  "editor.indentSize": "tabSize",
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "tailwindCSS.includeLanguages": {
    "css": "tailwindcss"
  },
  "tailwindCSS.experimental.configFile": "apps/docs/app/assets/css/main.css",
  "files.eol": "\n",
  "eslint.runtime": "node",
  "mdc.enableComponentMetadataCompletions": true,
  "mdc.enableFormatting": true,
  "tailwindCSS.classAttributes": [
    "class",
    "ui"
  ],
  "tailwindCSS.classFunctions": [
    "tv",
    "defineAppConfig"
  ],
  "tailwindCSS.experimental.classRegex": [
    [
      "Classes\\s*=\\s*computed\\(\\(\\)\\s*=>\\s*([\\s\\S]+?)\\)",
      "'([^']+)'"
    ]
  ],
  "npm.packageManager": "pnpm",
  "cSpell.ignorePaths": [
    "package-lock.json",
    ".gitignore",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "pnpm-lock.yaml",
    "CHANGELOG.md"
  ],
  "eslint.validate": [
    "javascript",
    "vue",
    "typescript",
    "json",
    "jsonc",
    "json5",
    "html",
    "markdown",
    "yaml",
    "yml",
    "mdc",
    "css"
  ],
  "[mdc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "cSpell.words": [
    "dequal",
    "Emeka",
    "favorodera",
    "klona",
    "notform",
    "nuxt",
    "Promisable",
    "relizy",
    "tsdown",
    "untouch",
    "vite",
    "vitejs",
    "vitest"
  ]
}