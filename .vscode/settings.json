{
  "files.autoSave": "afterDelay",
  "git.autofetch": true,
  "editor.tabSize": 2,
  "vue.format.script.initialIndent": true,
  "vue.format.style.initialIndent": true,
  "vue.hover.rich": true,
  "vue.inlayHints.destructuredProps": true,
  "vue.inlayHints.inlineHandlerLeading": true,
  "vue.inlayHints.missingProps": true,
  "vue.inlayHints.optionsWrapper": true,
  "vue.inlayHints.vBindShorthand": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.inlayHints.parameterNames.enabled": "all",
  "javascript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": true,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.suggest.snippetsPreventQuickSuggestions": true,
  "editor.quickSuggestions": {
    "strings": true,
    "comments": "on"
  },
  "editor.minimap.enabled": false,
  "terminal.integrated.cursorStyle": "line",
  "scm.compactFolders": false,
  "explorer.compactFolders": false,
  "eslint.format.enable": true,
  "css.lint.unknownAtRules": "ignore",
  "editor.stickyScroll.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "editor.wordWrap": "on",
  "editor.detectIndentation": false,
  "editor.indentSize": "tabSize",
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "tailwindCSS.includeLanguages": {
    "css": "tailwindcss"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.inlayHints.padding": true,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.scrollWithEditor": false,
  "files.eol": "\n",
  "css.lint.zeroUnits": "warning",
  "css.lint.duplicateProperties": "error",
  "editor.inlayHints.enabled": "on",
  "workbench.iconTheme": "vscode-icons",
  "eslint.runtime": "node",
  "mdc.enableComponentMetadataCompletions": true,
  "mdc.enableFormatting": true,
  "tailwindCSS.classAttributes": [
    "class",
    "ui"
  ],
  "tailwindCSS.classFunctions": [
    "tv",
    "defineAppConfig"
  ],
  "tailwindCSS.experimental.classRegex": [
    [
      "Classes\\s*=\\s*computed\\(\\(\\)\\s*=>\\s*([\\s\\S]+?)\\)",
      "'([^']+)'"
    ]
  ],
  "editor.linkedEditing": true,
  "git.replaceTagsWhenPull": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.wrapOnEscapedLineFeeds": true,
  "iconify.languageIds": [
    "javascript",
    "typescript",
    "vue",
    "json",
    "yaml",
    "markdown",
    "mdx",
    "md",
    "mdc"
  ],
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "workbench.remoteIndicator.showExtensionRecommendations": false,
  "telemetry.telemetryLevel": "off",
  "markdown.updateLinksOnFileMove.enabled": "prompt",
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "format/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-indent",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spacing",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spaces",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-order",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-dangle",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-newline",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*quotes",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*semi",
      "severity": "off",
      "fixable": true
    }
  ],
  "npm.packageManager": "pnpm",
  "editor.defaultColorDecorators": "always",
  "editor.inlayHints.maximumLength": 10,
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "pnpm-lock.yaml"
  ],
  "eslint.validate": [
    "javascript",
    "vue",
    "typescript",
    "json",
    "jsonc",
    "json5",
    "html",
    "markdown",
    "yaml",
    "yml",
    "mdc"
  ],
  "workbench.navigationControl.enabled": false,
  "telemetry.feedback.enabled": false,
  "workbench.editor.enablePreview": false,
  "[mdc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnPaste": true
  },
  "cSpell.words": [
    "arktype",
    "bunx",
    "dequal",
    "Emeka",
    "enctype",
    "favorodera",
    "focusout",
    "initialising",
    "jsdom",
    "klona",
    "llms",
    "misrouted",
    "noopener",
    "noreferrer",
    "notform",
    "nums",
    "nuxi",
    "Nuxt",
    "nuxtdotjs",
    "relizy",
    "renderless",
    "Shadcn",
    "Subline",
    "tabler",
    "takumi",
    "tsup",
    "Turborepo",
    "Unmarks",
    "Upserts",
    "Valibot",
    "Vite",
    "Vitest",
    "vuedotjs",
    "vueuse"
  ]
}