{
  "files.autoSave": "afterDelay",
  "git.autofetch": true,
  "editor.tabSize": 2,
  "vue.format.script.initialIndent": true,
  "vue.format.style.initialIndent": true,
  "editor.suggest.snippetsPreventQuickSuggestions": true,
  "editor.quickSuggestions": {
    "strings": "on",
    "other": "on"
  },
  "eslint.format.enable": true,
  "editor.detectIndentation": false,
  "editor.indentSize": "tabSize",
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "tailwindCSS.includeLanguages": {
    "css": "tailwindcss"
  },
  "tailwindCSS.experimental.configFile": "apps/docs/app/assets/css/main.css",
  "diffEditor.ignoreTrimWhitespace": false,
  "files.eol": "\n",
  "workbench.iconTheme": "vscode-icons",
  "eslint.runtime": "node",
  "mdc.enableComponentMetadataCompletions": true,
  "mdc.enableFormatting": true,
  "tailwindCSS.classAttributes": [
    "class",
    "ui"
  ],
  "tailwindCSS.classFunctions": [
    "tv",
    "defineAppConfig"
  ],
  "tailwindCSS.experimental.classRegex": [
    [
      "Classes\\s*=\\s*computed\\(\\(\\)\\s*=>\\s*([\\s\\S]+?)\\)",
      "'([^']+)'"
    ]
  ],
  "editor.linkedEditing": true,
  "git.replaceTagsWhenPull": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.wrapOnEscapedLineFeeds": true,
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "format/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-indent",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spacing",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spaces",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-order",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-dangle",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-newline",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*quotes",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*semi",
      "severity": "off",
      "fixable": true
    }
  ],
  "npm.packageManager": "pnpm",
  "editor.defaultColorDecorators": "always",
  "editor.inlayHints.maximumLength": 10,
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "pnpm-lock.yaml"
  ],
  "eslint.validate": [
    "javascript",
    "vue",
    "typescript",
    "json",
    "jsonc",
    "json5",
    "html",
    "markdown",
    "yaml",
    "yml",
    "mdc",
    "css"
  ],
  "[mdc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "cSpell.words": [
    "arktype",
    "bunx",
    "demi",
    "dequal",
    "Emeka",
    "enctype",
    "esbuild",
    "favorodera",
    "focusout",
    "iconify",
    "initialising",
    "jsdom",
    "klona",
    "llms",
    "minimark",
    "minlength",
    "misrouted",
    "noopener",
    "noreferrer",
    "notform",
    "novalidate",
    "nums",
    "nuxi",
    "Nuxt",
    "nuxtdotjs",
    "nuxtjs",
    "nuxtseo",
    "preid",
    "premajor",
    "preminor",
    "prepatch",
    "relizy",
    "remint",
    "renderless",
    "Shadcn",
    "slideover",
    "stackblitz",
    "Subline",
    "tabler",
    "takumi",
    "tsdown",
    "tsup",
    "Turborepo",
    "Unmarks",
    "unrs",
    "Upserts",
    "Valibot",
    "vercel",
    "Vite",
    "vitejs",
    "Vitest",
    "vuedotjs",
    "vueuse"
  ]
}